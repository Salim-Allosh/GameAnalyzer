<Window x:Class="SportsAnalytics.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SportsAnalytics.Desktop.ViewModels"
        xmlns:views="clr-namespace:SportsAnalytics.Desktop.Views"
        mc:Ignorable="d"
        Title="نظام تحليل وتنبؤ رياضي" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="14">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MatchSelectionViewModel}">
            <views:MatchSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessingViewModel}">
            <views:ProcessingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PredictionArchiveViewModel}">
            <views:PredictionArchiveView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#f0f2f5">
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
