<UserControl x:Class="SportsAnalytics.Desktop.Views.MatchSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SportsAnalytics.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:MatchSelectionViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="اختر مباراة للتحليل" FontSize="24" FontWeight="Bold"/>
            
            <Button Grid.Column="1" Content="تحديث الجداول من API" Command="{Binding SyncFixturesCommand}" 
                    Padding="10,5" Background="#28a745" Foreground="White" FontWeight="Bold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Content" Value="جاري التحديث..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- منطقة عرض المباريات مع مؤشر التحميل المتراكب -->
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedMatch}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="35" FontSize="14" AlternatingRowBackground="#f9f9f9"
                      BorderThickness="1" BorderBrush="#ddd" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding MatchDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                    <DataGridTextColumn Header="الدوري" Binding="{Binding League}" Width="150" />
                    <DataGridTextColumn Header="الفريق المضيف" Binding="{Binding HomeTeam.Name}" Width="200" />
                    <DataGridTextColumn Header="الفريق الضيف" Binding="{Binding AwayTeam.Name}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- مؤشر التحميل في المنتصف -->
            <Border Background="#88FFFFFF" Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="10" Margin="0,0,0,10"/>
                    <TextBlock Text="جاري جلب المباريات..." FontSize="18" FontWeight="Bold" Foreground="#333"/>
                </StackPanel>
            </Border>

            <!-- رسالة لا توجد مباريات -->
            <Border Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" IsHitTestVisible="False">
                <TextBlock Text="لا يوجد أي مباريات حالياً. اضغط على زر التحديث لجلب المباريات." 
                           FontSize="18" FontWeight="Bold" Foreground="#888" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <Button Grid.Row="2" Content="تحليل المباراة" Command="{Binding AnalyzeCommand}" 
                Margin="0,20,0,0" Padding="15,10" FontSize="16" FontWeight="Bold" 
                HorizontalAlignment="Right" Background="#007ACC" Foreground="White"/>
    </Grid>
</UserControl>
