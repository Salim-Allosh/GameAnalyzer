<UserControl x:Class="SportsAnalytics.Desktop.Views.MatchSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SportsAnalytics.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:MatchSelectionViewModel}">
             
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- Modern Card Style -->
        <Style x:Key="MatchCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30" />
                    <Setter Property="BorderBrush" Value="#007ACC" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#007ACC" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <!-- Top Bar: Filters & Manual Selection -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: Match Cards -->
            <RowDefinition Height="*"/>
            <!-- Bottom Bar: Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Area: Controls -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- League Filter -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Manual Selection -->
                </Grid.ColumnDefinitions>

                <!-- League Filter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="تصفية حسب الدوري:" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <ComboBox ItemsSource="{Binding AvailableLeagues}" SelectedItem="{Binding SelectedLeague}" 
                              Width="200" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Manual Selection -->
                <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="8" Padding="15,10" BorderBrush="#3F3F46" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="تحليل مخصص:" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <!-- Home Team -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="المضيف" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableTeams}" SelectedItem="{Binding ManualHomeTeam}" DisplayMemberPath="Name" Width="150"/>
                        </StackPanel>

                        <TextBlock Text="VS" Foreground="#555" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,20,0"/>

                        <!-- Away Team -->
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="الضيف" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableTeams}" SelectedItem="{Binding ManualAwayTeam}" DisplayMemberPath="Name" Width="150"/>
                        </StackPanel>

                        <Button Content="بحث وتحليل" Command="{Binding AnalyzeManualMatchCommand}" 
                                Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="15,8" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#005A9E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Middle Area: Match Cards Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <!-- Loading Overlay -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="10">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="#007ACC" Margin="0,0,0,15"/>
                    <TextBlock Text="جاري تحديث البيانات من المزود..." Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- No Matches Message -->
                <TextBlock Text="لا توجد مباريات متاحة لهذا الدوري." Foreground="#888" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Cards Grid -->
                <ItemsControl ItemsSource="{Binding FilteredMatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="MatchCard" Style="{StaticResource MatchCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Match Header (Date & League) -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                        <TextBlock Text="{Binding League}" Foreground="#007ACC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MatchDate, StringFormat=dd/MM/yyyy HH:mm}" Foreground="#888" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Teams Area -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Home Team -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="60" Height="60" CornerRadius="30" Background="#333337" Margin="0,0,0,10">
                                                <Image Source="{Binding HomeTeam.LogoPath, FallbackValue={x:Null}}" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding HomeTeam.Name}" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="100"/>
                                        </StackPanel>

                                        <!-- VS Label -->
                                        <TextBlock Grid.Column="1" Text="VS" Foreground="#555" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                                        <!-- Away Team -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="60" Height="60" CornerRadius="30" Background="#333337" Margin="0,0,0,10">
                                                <Image Source="{Binding AwayTeam.LogoPath, FallbackValue={x:Null}}" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding AwayTeam.Name}" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="100"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hover Overlay with Analyze Button -->
                                    <Border CornerRadius="12" Grid.RowSpan="2" Background="#CC1E1E1E">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=MatchCard}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Content="تحليل المباراة" 
                                                Command="{Binding DataContext.AnalyzeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="15,10" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Cursor="Hand" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Area: Actions -->
        <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding SyncFixturesCommand}" Margin="0,0,15,0" Padding="20,10" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#28A745"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Content" Value="تحديث الجداول من API"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content" Value="جاري التحديث..."/>
                                    <Setter Property="Background" Value="#555"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#218838"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Archive Button -->
                <Button Content="الأرشيف" Command="{Binding OpenArchiveCommand}" 
                        Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="30,10" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#005A9E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
