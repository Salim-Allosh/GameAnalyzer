<UserControl x:Class="SportsAnalytics.Desktop.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SportsAnalytics.Desktop.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:ReportViewModel}"
             Background="#1E1E1E" FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Action Bar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="← رجوع" Command="{Binding GoBackCommand}" Padding="15,8" Margin="0,0,15,0" 
                        Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                <Button Content="إحصائيات متقدمة 📊" Command="{Binding OpenAdvancedStatsCommand}" Padding="15,8" Margin="0,0,15,0" 
                        Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="{Binding Report.HomeTeam}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" ضد " FontSize="28" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Report.AwayTeam}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- H2H Historical Reality & Date Range Banner -->
            <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="نطاق وتاريخ البحث" Foreground="#AAA" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding Report.EarliestDataDate, StringFormat=من {0:yyyy-MM-dd}}" Foreground="#FFC107" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="  إلى  " Foreground="#AAA" FontSize="14"/>
                            <TextBlock Text="{Binding Report.LatestDataDate, StringFormat={}{0:yyyy-MM-dd}}" Foreground="#4CAF50" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="مقارنة التوقع بالواقع التاريخي للمواجهات المباشرة 🔍" Foreground="#007ACC" FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Report.H2HComparisonSummary}" Foreground="White" FontSize="13" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="8" Padding="12,8" VerticalAlignment="Center" Margin="15,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="مطابقة الواقع" Foreground="#AAA" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Report.H2HRealismMatchScore, StringFormat={}{0:F1}%}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Blended Probabilities -->
                <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="الاحتمالات النهائية المدمجة" FontSize="18" FontWeight="SemiBold" Foreground="#007ACC" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Report.HomeTeam, StringFormat=فوز {0}}" Foreground="#AAA" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Report.BlendHomeWin, StringFormat=P1}" FontSize="24" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="تعادل" Foreground="#AAA" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Report.BlendDraw, StringFormat=P1}" FontSize="24" FontWeight="Bold" Foreground="#FFC107"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Report.AwayTeam, StringFormat=فوز {0}}" Foreground="#AAA" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Report.BlendAwayWin, StringFormat=P1}" FontSize="24" FontWeight="Bold" Foreground="#F44336"/>
                            </StackPanel>
                        </Grid>
                        <Separator Background="#3F3F46" Margin="0,20,0,15"/>
                        <TextBlock Text="{Binding Report.MostLikelyOutcome, StringFormat=أكثر نتيجة متوقعة: {0}}" 
                                   FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Risk Score -->
                <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="تحليل المخاطرة (Risk Score)" FontSize="18" FontWeight="SemiBold" Foreground="#007ACC" Margin="0,0,0,15"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="مستوى المخاطرة:" Foreground="#AAA" Width="130" FontSize="15"/>
                            <TextBlock Text="{Binding Report.Risk.RiskLevel}" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="مؤشر المخاطرة:" Foreground="#AAA" Width="130" FontSize="15"/>
                            <TextBlock Text="{Binding Report.Risk.RiskScore, StringFormat=F1}" Foreground="White" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text=" / 100" Foreground="#555" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="أعلى قيمة (Best EV):" Foreground="#AAA" Width="130" FontSize="15"/>
                            <TextBlock Text="{Binding Report.Risk.BestEV, StringFormat=F3}" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="جودة البيانات:" Foreground="#AAA" Width="130" FontSize="15"/>
                            <TextBlock Text="{Binding Report.Risk.DataQuality, StringFormat=P0}" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>

                        <TextBlock Text="مبررات المخاطرة:" Foreground="#AAA" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="14"/>
                        <TextBlock Text="{Binding Report.Risk.Explanation}" Foreground="White" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <!-- Models Comparison -->
                <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="تفاصيل النماذج المستخدمة" FontSize="18" FontWeight="SemiBold" Foreground="#007ACC" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Dixon-Coles:" Foreground="#AAA" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Report.DcHomeWin, StringFormat={}{0:P1}}" Foreground="#4CAF50" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text=" / " Foreground="#555" FontSize="15"/>
                                <TextBlock Text="{Binding Report.DcDraw, StringFormat={}{0:P1}}" Foreground="#FFC107" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text=" / " Foreground="#555" FontSize="15"/>
                                <TextBlock Text="{Binding Report.DcAwayWin, StringFormat={}{0:P1}}" Foreground="#F44336" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Elo Rating:" Foreground="#AAA" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Report.EloRatingHome, StringFormat={}{0:F0}}" Foreground="#4CAF50" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text=" vs " Foreground="#555" FontSize="15"/>
                                <TextBlock Text="{Binding Report.EloRatingAway, StringFormat={}{0:F0}}" Foreground="#F44336" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Elo Prob:" Foreground="#AAA" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Report.EloHomeWin, StringFormat={}{0:P1}}" Foreground="#4CAF50" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text=" / " Foreground="#555" FontSize="15"/>
                                <TextBlock Text="{Binding Report.EloDraw, StringFormat={}{0:P1}}" Foreground="#FFC107" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text=" / " Foreground="#555" FontSize="15"/>
                                <TextBlock Text="{Binding Report.EloAwayWin, StringFormat={}{0:P1}}" Foreground="#F44336" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="ML.NET:" Foreground="#AAA" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Report.MlHomeWin, StringFormat={}{0:P1}}" Foreground="#4CAF50" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text=" / " Foreground="#555" FontSize="15"/>
                                <TextBlock Text="{Binding Report.MlDraw, StringFormat={}{0:P1}}" Foreground="#FFC107" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text=" / " Foreground="#555" FontSize="15"/>
                                <TextBlock Text="{Binding Report.MlAwayWin, StringFormat={}{0:P1}}" Foreground="#F44336" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Numbers & Statistics Explanation Table -->
            <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}">
                <StackPanel>
                    <TextBlock Text="جدول تفصيل ودلالة الأرقام والحسابات الإحصائية 📊" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,15"/>
                    <TextBlock Text="يوضح هذا الجدول مصدر كل رقم ظاهر في الشاشة، الفريق التابع له، طريقة حسابه الرياضية، ودلالته العملية في التوقع." Foreground="#AAA" Margin="0,0,0,15" TextWrapping="Wrap"/>
                    
                    <DataGrid ItemsSource="{Binding Report.NumberExplanations}" AutoGenerateColumns="False" 
                              Background="#1E1E1E" RowBackground="#252526" AlternatingRowBackground="#2D2D30" 
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" 
                              HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#333337"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم / النسبة" Binding="{Binding NumberValue}" FontWeight="Bold" Width="130"/>
                            <DataGridTextColumn Header="الفريق / الجهة" Binding="{Binding TeamName}" Foreground="#FFC107" Width="150"/>
                            <DataGridTextColumn Header="المؤشر" Binding="{Binding MetricName}" FontWeight="SemiBold" Width="200"/>
                            <DataGridTextColumn Header="الدلالة والمعنى الإحصائي" Binding="{Binding Meaning}" Width="*"/>
                            <DataGridTextColumn Header="طريقة الحساب والمصدر" Binding="{Binding SourceCalculation}" Foreground="#AAA" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Betting Markets -->
            <Border Grid.Row="4" Style="{StaticResource ModernCardStyle}">
                <StackPanel>
                    <TextBlock Text="أسواق المراهنات المدعومة (Betting Markets)" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                    
                    <ItemsControl ItemsSource="{Binding GroupedBettingMarkets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="{Binding Key}" FontSize="16" FontWeight="SemiBold" Foreground="#007ACC" Margin="0,0,0,10"/>
                                    
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#333337" BorderBrush="#555" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,15,15" Width="180">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Selection}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Probability, StringFormat={}{0:P1}}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" Margin="0,10,0,5"/>
                                                        <TextBlock Text="{Binding FairOdds, StringFormat=Fair Odds: {0:F2}}" FontSize="13" Foreground="#AAA"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="5" Text="{Binding Report.ComputationMs, StringFormat=وقت التحليل: {0:F0} ms}" 
                       HorizontalAlignment="Right" Foreground="#555" Margin="0,20,10,0" FontSize="12"/>
        </Grid>
    </ScrollViewer>
</UserControl>
